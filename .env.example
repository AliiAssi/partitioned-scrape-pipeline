# connection string
MONGO_URI=mongodb://localhost:27017
# database name
MONGO_DATABASE=wrc

# collections name
LANDING_COLLECTION=landing_decisions
CURATED_COLLECTION=curated_decisions


# MinIO speaks the S3 API, so moving to real S3 is easy.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# False against the local container, true against anything remote.
MINIO_SECURE=false

# The two zones. Landing keeps the bytes exactly as served; curated holds the cleaned
# documents renamed to identifier.ext.
LANDING_BUCKET=landing
CURATED_BUCKET=curated

#  Pipeline 
# One of: daily | weekly | monthly
PARTITION_SIZE=monthly

#  Crawling 
ROBOTS_OBEY=false
USER_AGENT=wrc-pipeline/1.0
CONCURRENT_REQUESTS_PER_DOMAIN=8
DOWNLOAD_DELAY=0.0

# Generous on purpose. A search page is ~810 KB served without compression and takes
# roughly 4.9 s; a tight timeout would turn ordinary slowness into fake failures.
DOWNLOAD_TIMEOUT=120

# How many times a 429, 408 or 5xx is retried before the record is given up on and
# logged as a failure with its URL and status.
RETRY_TIMES=3

# Lets Scrapy find the pace the origin can actually sustain instead of us guessing.
# The target is the average number of parallel requests it aims to keep open.
AUTOTHROTTLE_ENABLED=true
AUTOTHROTTLE_TARGET_CONCURRENCY=6.0

#  Storage retries 
STORAGE_RETRY_ATTEMPTS=3
STORAGE_RETRY_BACKOFF_SECONDS=0.5

#  Runtime 
CRAWL_WORKSPACE_DIR=/tmp/wrc_pipeline_crawls

# logs level
LOG_LEVEL=INFO

